{
  "name": "repa",
  "version": "1.0.0",
  "description": "Attendance write down system",
  "license": "MIT",
  "author": "Milan Koyš",
  "type": "module",
  "main": "index.js",
  "imports": {
    "#enums": "./build/enums/index.js",
    "#api": "./build/api/index.js",
    "#middleware": "./build/middleware/index.js",
    "#library": "./build/library/index.js",
    "#server": "./build/server.js",
    "#database": "./build/database.js",
    "#websocket": "./build/websocket.js",
    "#validator": "./build/validator.js",
    "#session": "./build/session.js"
  },
  "scripts": {
    "start": "node build/index.js",
    "dev": "npm run styles:watch | npm run compile:watch & npm run code:watch ",
    "build": "npm run styles:build | npm run compile:build",
    "code:watch": "nodemon -e js,html,css --watch web --watch build build/index.js",
    "compile:watch": "tsc --build --watch --preserveWatchOutput",
    "compile:build": "tsc --build",
    "styles:watch": "npx @tailwindcss/cli -i ./web/styles/input.css -o ./web/styles/styles.css --watch",
    "styles:build": "npx @tailwindcss/cli -i ./web/styles/input.css -o ./web/styles/styles.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.3",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mongodb": "^7.7.0"
  }
}
